<UserControl x:Class="SGBU.UI.Views.MisPrestamosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Mis préstamos" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />

    <DataGrid Grid.Row="1" ItemsSource="{Binding Prestamos}" SelectedItem="{Binding PrestamoSeleccionado}"
              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*" />
        <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="110" />
        <DataGridTextColumn Header="Prestado" Binding="{Binding FechaPrestamo, StringFormat=dd/MM/yyyy}" Width="80" />
        <DataGridTextColumn Header="Vence" Binding="{Binding FechaVencimiento, StringFormat=dd/MM/yyyy}" Width="80" />
        <DataGridCheckBoxColumn Header="Renovado" Binding="{Binding Renovado, Mode=OneWay}" Width="65" />
        <DataGridTextColumn Header="Días de atraso" Binding="{Binding DiasAtraso}" Width="90" />
      </DataGrid.Columns>
    </DataGrid>

    <Button Grid.Row="2" Content="Renovar el préstamo seleccionado" Command="{Binding RenovarCommand}"
            HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,2" />

    <TextBlock Grid.Row="3" Text="{Binding Mensaje}" Foreground="DarkBlue" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,0" />

    <!-- Multas pendientes -->
    <TextBlock Grid.Row="4" Text="Mis multas pendientes" FontSize="16" FontWeight="Bold" Margin="0,16,0,8" />
    <DataGrid Grid.Row="5" ItemsSource="{Binding Multas}" AutoGenerateColumns="False" IsReadOnly="True" Height="120">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Material" Binding="{Binding Titulo}" Width="*" />
        <DataGridTextColumn Header="Días de atraso" Binding="{Binding DiasAtraso}" Width="90" />
        <DataGridTextColumn Header="Monto (₡)" Binding="{Binding Monto, StringFormat=N0}" Width="80" />
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="6" Text="{Binding TotalMultas}" Foreground="Red" FontWeight="Bold" Margin="0,8,0,0" />
  </Grid>
</UserControl>
