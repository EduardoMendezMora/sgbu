<Window x:Class="SGBU.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource T_Login_Titulo}" Width="380" Height="330"
        ResizeMode="NoResize"
        Background="{StaticResource FondoVentana}" Foreground="{StaticResource ColorTexto}" WindowStartupLocation="CenterScreen">
  <StackPanel Margin="25">
    <TextBlock Text="{StaticResource T_Biblioteca}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" />

    <Label Content="{StaticResource T_EmailOCarne}" />
    <TextBox x:Name="txtUsuario" Text="{Binding Usuario}" Height="26" />

    <Label Content="{StaticResource T_Contrasena}" Margin="0,8,0,0" />
    <PasswordBox x:Name="txtContrasena" Height="26" PasswordChanged="Contrasena_Cambio" />

    <TextBlock Text="{Binding MensajeError}" Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0" />

    <Button x:Name="btnIngresar" Content="{StaticResource T_Ingresar}" Command="{Binding IniciarSesionCommand}" IsDefault="True" Height="30" Margin="0,10,0,0" />
  </StackPanel>
</Window>
