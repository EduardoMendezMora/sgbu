<Window x:Class="SGBU.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SGBU - Iniciar sesión" Width="380" Height="330"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
  <StackPanel Margin="25">
    <TextBlock Text="Biblioteca Universitaria" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" />

    <Label Content="Email o carné:" />
    <TextBox Text="{Binding Usuario}" Height="26" />

    <Label Content="Contraseña:" Margin="0,8,0,0" />
    <PasswordBox x:Name="txtContrasena" Height="26" PasswordChanged="Contrasena_Cambio" />

    <TextBlock Text="{Binding MensajeError}" Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0" />

    <Button Content="Ingresar" Command="{Binding IniciarSesionCommand}" IsDefault="True" Height="30" Margin="0,10,0,0" />
  </StackPanel>
</Window>
