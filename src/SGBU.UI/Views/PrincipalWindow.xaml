<Window x:Class="SGBU.UI.Views.PrincipalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SGBU.UI.ViewModels"
        xmlns:views="clr-namespace:SGBU.UI.Views"
        Title="SGBU - Biblioteca Universitaria" Width="1100" Height="650"
        WindowStartupLocation="CenterScreen">

  <!-- Para cada ViewModel se dibuja su vista -->
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:CatalogoViewModel}">
      <views:CatalogoView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PrestamosViewModel}">
      <views:PrestamosView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MisPrestamosViewModel}">
      <views:MisPrestamosView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:UsuariosViewModel}">
      <views:UsuariosView />
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="180" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Barra de arriba -->
    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Background="LightSteelBlue">
      <TextBlock Text="{Binding Bienvenida}" FontSize="14" FontWeight="Bold" Margin="10" />
      <TextBlock Text="{Binding Sesion.Rol}" Margin="0,10,10,10" />
      <Button x:Name="btnCerrarSesion" Content="Cerrar sesión" Command="{Binding CerrarSesionCommand}" Margin="10,6" Padding="8,2" />
    </StackPanel>

    <!-- Menú -->
    <ListBox x:Name="lstMenu" Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Opciones}" SelectedItem="{Binding OpcionSeleccionada}"
             DisplayMemberPath="Titulo" FontSize="14" />

    <!-- Pantalla elegida -->
    <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding VistaActual}" Margin="5" />
  </Grid>
</Window>
