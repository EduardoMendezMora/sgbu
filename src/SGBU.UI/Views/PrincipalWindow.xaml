<Window x:Class="SGBU.UI.Views.PrincipalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SGBU - Biblioteca Universitaria" Width="900" Height="550"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Barra de arriba -->
    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Background="LightSteelBlue">
      <TextBlock Text="{Binding Bienvenida}" FontSize="14" FontWeight="Bold" Margin="10" />
      <TextBlock Text="{Binding Sesion.Rol}" Margin="0,10,10,10" />
      <Button Content="Cerrar sesión" Command="{Binding CerrarSesionCommand}" Margin="10,6" Padding="8,2" />
    </StackPanel>

    <!-- Menú -->
    <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Opciones}" SelectedItem="{Binding OpcionSeleccionada}"
             DisplayMemberPath="Titulo" FontSize="14" />

    <!-- Contenido -->
    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Contenido}" FontSize="14" Margin="15" />
  </Grid>
</Window>
