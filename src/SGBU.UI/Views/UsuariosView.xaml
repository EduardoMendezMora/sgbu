<UserControl x:Class="SGBU.UI.Views.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Búsqueda -->
    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
      <Label Content="Buscar:" />
      <TextBox Text="{Binding TextoBuscar}" Width="220" />
      <Button Content="Buscar" Command="{Binding BuscarCommand}" Margin="10,0,0,0" Padding="10,0" IsDefault="True" />
    </StackPanel>

    <!-- Tabla de usuarios -->
    <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Usuarios}" SelectedItem="{Binding UsuarioSeleccionado}"
              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Carné" Binding="{Binding Carne}" />
        <DataGridTextColumn Header="Nombre" Binding="{Binding NombreCompleto}" Width="*" />
        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
        <DataGridTextColumn Header="Rol" Binding="{Binding Rol.Nombre}" />
        <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo, Mode=OneWay}" />
      </DataGrid.Columns>
    </DataGrid>

    <!-- Paginación -->
    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,8,0,0">
      <Button Content="&lt; Anterior" Command="{Binding AnteriorCommand}" Padding="8,2" />
      <TextBlock Text="{Binding InfoPagina}" Margin="10,0" VerticalAlignment="Center" />
      <Button Content="Siguiente &gt;" Command="{Binding SiguienteCommand}" Padding="8,2" />
    </StackPanel>

    <!-- Formulario -->
    <GroupBox Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Header="Usuario" Width="260" Margin="10,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="5">
          <Label Content="Carné:" />
          <TextBox Text="{Binding Carne}" />
          <Label Content="DNI (cédula o DIMEX):" />
          <TextBox Text="{Binding Dni}" />
          <Label Content="Nombre:" />
          <TextBox Text="{Binding Nombre}" />
          <Label Content="Apellidos:" />
          <TextBox Text="{Binding Apellidos}" />
          <Label Content="Email:" />
          <TextBox Text="{Binding Email}" />
          <Label Content="Teléfono:" />
          <TextBox Text="{Binding Telefono}" />
          <Label Content="Rol:" />
          <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Nombre" SelectedValuePath="Id" SelectedValue="{Binding RolId}" />
          <Label Content="Contraseña (vacía = no cambiar):" />
          <PasswordBox x:Name="txtContrasena" PasswordChanged="Contrasena_Cambio" />
          <CheckBox Content="Activo" IsChecked="{Binding Activo}" Margin="0,8,0,0" />

          <TextBlock Text="{Binding Mensaje}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />

          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Nuevo" Command="{Binding NuevoCommand}" Width="80" Click="Limpiar_Click" />
            <Button Content="Guardar" Command="{Binding GuardarCommand}" Width="80" Margin="10,0,0,0" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </GroupBox>
  </Grid>
</UserControl>
