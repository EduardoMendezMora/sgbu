<UserControl x:Class="SGBU.UI.Views.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="20" Width="320" HorizontalAlignment="Left">
    <TextBlock Text="{StaticResource T_ConfiguracionTitulo}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

    <Label Content="{StaticResource T_TemaLabel}" />
    <ComboBox x:Name="cmbTema" ItemsSource="{Binding Temas}" SelectedItem="{Binding TemaSeleccionado}" />

    <Label Content="{StaticResource T_IdiomaLabel}" Margin="0,10,0,0" />
    <ComboBox x:Name="cmbIdioma" ItemsSource="{Binding Idiomas}" SelectedItem="{Binding IdiomaSeleccionado}" />

    <Button x:Name="btnAplicar" Content="{StaticResource T_Aplicar}" Command="{Binding GuardarCommand}" Margin="0,16,0,0" Height="30" />

    <TextBlock Text="{StaticResource T_ConfigNota}" TextWrapping="Wrap" Margin="0,12,0,0" Opacity="0.7" />
  </StackPanel>
</UserControl>
