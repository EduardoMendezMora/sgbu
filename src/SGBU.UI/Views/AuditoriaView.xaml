<UserControl x:Class="SGBU.UI.Views.AuditoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Filtros -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
      <Label Content="{StaticResource T_AuditoriaBuscar}" />
      <TextBox Text="{Binding TextoBuscar}" Width="160" />
      <Label Content="{StaticResource T_Desde}" Margin="10,0,0,0" />
      <DatePicker SelectedDate="{Binding Desde}" />
      <Label Content="{StaticResource T_Hasta}" Margin="10,0,0,0" />
      <DatePicker SelectedDate="{Binding Hasta}" />
      <Button Content="{StaticResource T_BotonBuscar}" Command="{Binding BuscarCommand}" Margin="10,0,0,0" Padding="10,0" IsDefault="True" />
    </StackPanel>

    <!-- Bitácora -->
    <DataGrid Grid.Row="1" ItemsSource="{Binding Registros}" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{StaticResource T_ColFecha}" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="115" />
        <DataGridTextColumn Header="{StaticResource T_ColUsuario}" Binding="{Binding Usuario}" Width="*" />
        <DataGridTextColumn Header="{StaticResource T_ColAccion}" Binding="{Binding Accion}" Width="130" />
        <DataGridTextColumn Header="{StaticResource T_ColEntidad}" Binding="{Binding Entidad}" Width="90" />
        <DataGridTextColumn Header="{StaticResource T_ColDetalle}" Binding="{Binding Detalle}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

    <!-- Paginación -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
      <Button Content="{StaticResource T_Anterior}" Command="{Binding AnteriorCommand}" Padding="8,2" />
      <TextBlock Text="{Binding InfoPagina}" Margin="10,0" VerticalAlignment="Center" />
      <Button Content="{StaticResource T_Siguiente}" Command="{Binding SiguienteCommand}" Padding="8,2" />
    </StackPanel>

    <TextBlock Grid.Row="3" Text="{Binding Mensaje}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />
  </Grid>
</UserControl>
