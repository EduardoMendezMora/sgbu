<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Colores del tema oscuro. -->
  <SolidColorBrush x:Key="FondoVentana" Color="#1E1E1E" />
  <SolidColorBrush x:Key="ColorTexto" Color="#EEEEEE" />
  <SolidColorBrush x:Key="FondoBarra" Color="#2D3E50" />
  <SolidColorBrush x:Key="FondoControl" Color="#2B2B2B" />
  <SolidColorBrush x:Key="FondoTabla" Color="#252526" />
  <SolidColorBrush x:Key="FondoEncabezado" Color="#3A3A3A" />
  <SolidColorBrush x:Key="ColorBorde" Color="#555555" />
  <SolidColorBrush x:Key="ColorMensaje" Color="#7FB7FF" />

  <!-- Estilos que se aplican solos a todos los controles de ese tipo. -->
  <Style TargetType="Label">
    <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
  </Style>
  <Style TargetType="GroupBox">
    <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource FondoControl}" />
    <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
    <Setter Property="CaretBrush" Value="{StaticResource ColorTexto}" />
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Background" Value="{StaticResource FondoControl}" />
    <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
    <Setter Property="CaretBrush" Value="{StaticResource ColorTexto}" />
  </Style>
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource FondoVentana}" />
    <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
  </Style>
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource FondoTabla}" />
    <Setter Property="RowBackground" Value="{StaticResource FondoControl}" />
    <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ColorBorde}" />
    <Setter Property="VerticalGridLinesBrush" Value="{StaticResource ColorBorde}" />
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource FondoEncabezado}" />
    <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="Padding" Value="4,2" />
  </Style>
</ResourceDictionary>
