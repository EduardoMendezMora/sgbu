<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Colores del tema claro. -->
  <SolidColorBrush x:Key="FondoVentana" Color="White" />
  <SolidColorBrush x:Key="ColorTexto" Color="Black" />
  <SolidColorBrush x:Key="FondoBarra" Color="LightSteelBlue" />
  <SolidColorBrush x:Key="FondoControl" Color="White" />
  <SolidColorBrush x:Key="FondoTabla" Color="#F0F0F0" />
  <SolidColorBrush x:Key="FondoEncabezado" Color="#E8E8E8" />
  <SolidColorBrush x:Key="ColorBorde" Color="#ABADB3" />
  <SolidColorBrush x:Key="ColorMensaje" Color="DarkBlue" />

  <!-- Estilos que se aplican solos a todos los controles de ese tipo. -->
  <Style TargetType="Label">
    <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
  </Style>
  <Style TargetType="GroupBox">
    <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource FondoControl}" />
    <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
    <Setter Property="CaretBrush" Value="{StaticResource ColorTexto}" />
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Background" Value="{StaticResource FondoControl}" />
    <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
    <Setter Property="CaretBrush" Value="{StaticResource ColorTexto}" />
  </Style>
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource FondoVentana}" />
    <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
  </Style>
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource FondoTabla}" />
    <Setter Property="RowBackground" Value="{StaticResource FondoControl}" />
    <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ColorBorde}" />
    <Setter Property="VerticalGridLinesBrush" Value="{StaticResource ColorBorde}" />
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource FondoEncabezado}" />
    <Setter Property="Foreground" Value="{StaticResource ColorTexto}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="Padding" Value="4,2" />
  </Style>
</ResourceDictionary>
