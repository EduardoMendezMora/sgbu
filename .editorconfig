root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{csproj,props,slnx,xaml,yml,json}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# Reglas de StyleCop que NO usamos en este proyecto
dotnet_diagnostic.SA0001.severity = none   # análisis de comentarios XML
dotnet_diagnostic.SA1101.severity = none   # prefijo this.
dotnet_diagnostic.SA1200.severity = none   # usings dentro del namespace
dotnet_diagnostic.SA1309.severity = none   # campos con guion bajo (_campo)
dotnet_diagnostic.SA1600.severity = none   # documentar todo elemento
dotnet_diagnostic.SA1633.severity = none   # encabezado de archivo
